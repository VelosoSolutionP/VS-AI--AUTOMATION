{
  "_nota": "REFERENCIA APENAS — nao copie e cole. Rode `vs-install`: o instalador grava estes hooks no settings da ferramenta detectada, com o caminho absoluto DESTA instalacao, em merge idempotente que preserva seus proprios hooks. Colar a mao com caminho de outra maquina deixa a suite muda: as tools respondem, mas nada governa.",
  "_gerado_por": "installer/hooks-config.mjs (HOOKS_SPEC) — fonte unica da verdade do wiring",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-session.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-task.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-timebox-guard.mjs"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-commit.mjs"
          },
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-git-guard.mjs"
          },
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-qa-gate.mjs"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-agent-guard.mjs"
          }
        ],
        "matcher": "Task|Agent|Dispatch|dispatch_agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-bg-guard.mjs"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-branch-first.mjs"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <CAMINHO-DA-INSTALACAO>/hooks/on-doc.mjs"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ]
  }
}
