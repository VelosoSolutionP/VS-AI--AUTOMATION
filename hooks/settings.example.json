{
  "_nota": "Cole em .claude/settings.json do projeto (ou ~/.claude/settings.json). Ajuste o caminho absoluto da engine. Testar em sessao real do Claude Code.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-session.mjs" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-task.mjs" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-commit.mjs" },
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-git-guard.mjs" },
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-qa-gate.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node C:/Veloso/ProjetosMsb/qa-gate/hooks/on-doc.mjs" }
        ]
      }
    ]
  }
}
