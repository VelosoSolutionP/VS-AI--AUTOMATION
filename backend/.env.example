# QA-Gate licensing backend — variáveis (colocar no .env da VPS, NUNCA commitar)

PORT=8787

# Stripe (dashboard → Developers → API keys / Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx        # secret do endpoint de webhook

# Chave PRIVADA Ed25519 (PEM). Na VPS use env; local cai no license/.keys/private.pem
# Gerar par: já existe em license/.keys/private.pem (guardar OFFLINE, backup seguro)
QA_GATE_PRIVATE_KEY=

