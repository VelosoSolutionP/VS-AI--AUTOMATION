node_modules/
.state/
.shots/
# NUNCA commitar a chave privada de assinatura de licenca (backend only)
license/.keys/
*.pem
!license/pubkey.pem

.metrics/
.consent/
.qa-gate-off

# artefato de distribuicao (gerado por build-protected.mjs)
dist/

# trial guard (anti-tamper, local)
.vsguard
installer/.url

# Credenciais soltas na raiz. "Recebimento" guarda a chave do Asaas — um commit
# descuidado levaria ela pro GitHub, e chave de gateway vazada movimenta dinheiro
# de verdade.
Recebimento
Recebimento.*
*.secret
.env
.env.*
!.env.example

# Sessao do WhatsApp Web (WPPConnect). E CREDENCIAL: quem tiver esta pasta
# entra no WhatsApp do cliente sem ler QR nenhum. Nunca versionar.
tokens/

# Credenciais soltas dentro do repo. As de PRODUCAO do Mercado Pago estavam aqui
# em texto puro, a um `git add` de irem parar no GitHub. O lugar delas e
# ~/.qa-gate/console/painel.env (600), fora do versionamento.
backend/Mercado-Livre
backend/MercadoLivreTeste
backend/WebHooks
**/Acessos*.md
# Anotacoes de credencial que apareceram soltas no backend (client key, app id,
# app secret do TikTok). Nao estavam rastreadas, mas tambem nao estavam
# ignoradas — a um `git add .` distraido de irem pro GitHub.
backend/Chave
backend/Partner
backend/Tik
backend/Me
# Rede larga: qualquer arquivo de credencial solto no backend fora de .mjs/.html.
backend/*.ovpn
license/*.original-*
# Chave/segredo em texto: nunca versionar, em nenhuma pasta.
**/*secret*.txt
**/*.secret
**/id_rsa
**/*.ppk
