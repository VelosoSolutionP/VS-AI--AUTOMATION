{
  "name": "@velososolution/qa-gate",
  "version": "1.1.0",
  "type": "module",
  "description": "QA-Gate — simulacao em browser real antes do commit. Injeta bug, exige mensagem amigavel + console limpo. So commita no verde.",
  "homepage": "https://velososolution.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelosoSolutionP/OrquestrarQaGate.git"
  },
  "author": "Veloso Solution <velosobil@gmail.com>",
  "license": "SEE LICENSE IN README.md",
  "keywords": [
    "qa",
    "testing",
    "pre-commit",
    "playwright",
    "livewire",
    "laravel",
    "browser",
    "mcp"
  ],
  "bin": {
    "qa-gate": "./qa-gate.mjs",
    "qa-gate-mcp": "./mcp/server.mjs",
    "vsqa": "./engine/vsqa/cli.mjs",
    "vsdiretoria": "./engine/vsdiretoria/cli.mjs",
    "vsvendas": "./engine/vsvendas/cli.mjs",
    "vs-install": "./installer/cli.mjs",
    "vsinfluence": "./engine/vsinfluence/cli.mjs",
    "vstiktok": "./engine/vstiktok/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "engine/",
    "mcp/server.mjs",
    "catalog/",
    "hooks/",
    "license/license.mjs",
    "license/pubkey.pem",
    "commands/",
    ".claude-plugin/",
    ".mcp.json",
    "qa-gate.mjs",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0"
  }
